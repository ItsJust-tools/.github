# .env.example
# ------------------------------------------------------------------
# This repository hosts the ItsJust organization profile (`.github`).
# It is a static org profile and does not run application code itself.
#
# The individual tools in the ItsJust org are built with Next.js,
# TypeScript and Tailwind, and are deployed on Vercel. The variables
# below are the common environment values used across those tool
# repositories. Copy this file to `.env.local` (or `.env`) and fill in
# your own values. Never commit real secrets.
#
# For Vercel deployments, set these in the project's Environment
# Variables settings instead of committing them to the repository.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Next.js
# ------------------------------------------------------------------
# Public base URL of the deployed app (no trailing slash).
# NEXT_PUBLIC_SITE_URL=https://itsjust.tools

# ------------------------------------------------------------------
# Vercel (optional)
# ------------------------------------------------------------------
# VERCEL_ENV=development
# VERCEL_GIT_COMMIT_SHA=

# ------------------------------------------------------------------
# Analytics / Observability (optional)
# ------------------------------------------------------------------
# NEXT_PUBLIC_ANALYTICS_ID=

# ------------------------------------------------------------------
# Example: secrets (never commit real values)
# ------------------------------------------------------------------
# DATABASE_URL=postgres://user:password@localhost:5432/db
# AUTH_SECRET=change-me
